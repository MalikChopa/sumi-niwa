{
  "name": "jardin-encre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jardin d'encre : jardin génératif à l'encre dans le navigateur (J2 : boucle jouable)",
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "vite --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/scan-dist.mjs",
    "build:test": "tsc --noEmit && vite build --mode test",
    "preview": "vite preview --port 4181 --strictPort",
    "preview:test": "vite preview --mode test --port 4182 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "playwright test -c tests/playwright.config.ts",
    "size-report": "node scripts/size-report.mjs",
    "probe": "node scripts/probe-webgpu.mjs",
    "probe:particles": "node scripts/bench.mjs --probe",
    "bench": "node scripts/bench.mjs",
    "test:unit": "vitest run",
    "golden:update": "vitest run --mode golden tests/unit/determinism.test.ts"
  }
}
